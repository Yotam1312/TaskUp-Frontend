{
  "expo": {
    "name": "UniTask",
    "slug": "taskup",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/ios_icon.png",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet":  true,
      "bundleIdentifier": "com.harelYotam.unitask",
      "buildNumber": "1.0.8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      },
      "package": "com.harel.taskup",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon.png",
          "color": "#4f46e5"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5846f7e2-210c-4346-b920-8bc32ab1c38a"
      }
    },
    "owner": "harelcohen9"
  }
}
